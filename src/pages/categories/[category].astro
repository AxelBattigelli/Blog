---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, groupByCategory } from "../../lib/posts";

export async function getStaticPaths() {
  const categories = groupByCategory(await getPosts());
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const count = category.posts.length;
---

<Base title={category.name} description={`Posts in ${category.name}.`}>
  <header class="page-header">
    <h1>{category.name}</h1>
    <p class="lede">{count} post{count === 1 ? "" : "s"}</p>
  </header>
  <PostList posts={category.posts} />
</Base>
