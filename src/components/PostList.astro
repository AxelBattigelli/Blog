---
import type { CollectionEntry } from "astro:content";
import Pin from "./Pin.astro";
import { formatDate, isoDate } from "../lib/dates";
import { slugify } from "../lib/slug";
import { url } from "../lib/url";

interface Props {
  posts: CollectionEntry<"posts">[];
  titleLevel?: "h2" | "h3";
}

const { posts, titleLevel = "h2" } = Astro.props;
const TitleTag = titleLevel === "h3" ? "h3" : "h2";
---

{
  posts.length === 0 ? (
    <p class="empty">No posts yet.</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <p class="meta">
              {
                post.data.pinned && (
                  <>
                    <Pin />
                    <span aria-hidden="true">·</span>
                  </>
                )
              }
              <a href={url(`/categories/${slugify(post.data.category)}/`)}>{post.data.category}</a>
              <span aria-hidden="true">·</span>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            </p>
            <TitleTag>
              <a href={url(`/posts/${post.id}/`)}>{post.data.title}</a>
            </TitleTag>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  )
}
